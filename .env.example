# Copy to .env and fill in. .env is gitignored.

# Anthropic API key — server-side only, never shipped to the client.
ANTHROPIC_API_KEY=

# Shared access code gating the public URL (one code for all reviewers).
# Required before a public deploy; may be blank for local dev.
ACCESS_CODE=

# Cost circuit-breakers (protect the API key from abusive use).
MAX_DAILY_LLM_CALLS=500
RATE_LIMIT_PER_MIN=20
